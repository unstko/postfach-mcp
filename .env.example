# postfach-mcp configuration. Copy the variables you need into the
# environment (e.g. an EnvironmentFile referenced by a systemd unit,
# chmod 600). Never commit real values.

# --- IMAP account (required) ---
POSTFACH_MCP_IMAP_HOST=imap.example.org
POSTFACH_MCP_IMAP_USER=you@example.org
POSTFACH_MCP_IMAP_PASSWORD=
# POSTFACH_MCP_IMAP_PORT=993

# Folder that receives drafts created by the create_draft tool.
# Check your server's actual name with the list_folders tool.
# POSTFACH_MCP_DRAFTS_FOLDER=Drafts

# From address for drafts; defaults to POSTFACH_MCP_IMAP_USER.
# POSTFACH_MCP_FROM_ADDRESS=Your Name <you@example.org>

# Draft body format: "text" (plain text, the default) or "html" (plain
# text plus an HTML alternative part — for clients whose HTML-based
# composer collapses plain-text line breaks, Spark for example).
# POSTFACH_MCP_DRAFT_FORMAT=text

# --- HTTP server ---
# Bearer token every MCP request must present. Required for `serve`.
# Generate with: openssl rand -hex 32
POSTFACH_MCP_TOKEN=

# POSTFACH_MCP_HOST=127.0.0.1
# POSTFACH_MCP_PORT=8000

# Host names under which the server may be addressed (comma-separated).
# Add the public name your reverse proxy or tunnel uses — requests with
# any other Host header are rejected (DNS-rebinding protection).
# POSTFACH_MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# Reserved for a future explicit opt-in, not implemented in v0.1:
# a send tool would only ever be registered when this is set.
# POSTFACH_MCP_ENABLE_SEND=
